{
  "name": "excel-lite",
  "version": "0.1.3",
  "description": "Read and write .xlsx in Node and the browser \u2014 streaming rows, no native deps, zero config.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "excel-lite": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "ROADMAP.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "SUPPORT.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "npm run build && vitest run",
    "bench": "node scripts/bench.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run verify",
    "fixtures": "python3 scripts/make-fixtures.py",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "npm run build && vitest run -c vitest.config.coverage.ts --coverage",
    "check:links": "node scripts/check-links.mjs",
    "check:bundle": "node scripts/check-browser-bundle.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run check:links && npm run check:bundle",
    "docs:build": "node site/build.mjs",
    "docs:serve": "node site/serve.mjs",
    "metrics": "node scripts/metrics.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.14.0",
    "exceljs": "^4.4.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "prettier": "^3.9.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.0.0",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "xlsx",
    "excel",
    "spreadsheet",
    "ooxml",
    "reader",
    "writer",
    "streaming",
    "csv",
    "browser"
  ],
  "author": "Muneeb Anjum <horizonbymuneeb@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horizonbymuneeb/excel-lite.git"
  },
  "homepage": "https://horizonbymuneeb.github.io/excel-lite/",
  "bugs": {
    "url": "https://github.com/horizonbymuneeb/excel-lite/issues"
  }
}
